# ===========================================
# Kiongozi API Server Environment Variables
# ===========================================

# Server Configuration
PORT=3001
NODE_ENV=production

# ===========================================
# REQUIRED: Supabase Configuration
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===========================================
# REQUIRED: Prisma / Direct DB Connection
# Get from: Supabase Dashboard → Settings → Database → "Transaction pooler" tab
# IMPORTANT: Use port 6543 (Transaction mode), NOT 5432
# ===========================================
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-DB-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ===========================================
# REQUIRED: OpenAI Configuration
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# REQUIRED: JWT Secret
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===========================================
# REQUIRED: Allowed Origins (CORS)
# ===========================================
ALLOWED_ORIGINS=https://kiongozi.vercel.app,http://localhost:3000

# ===========================================
# OPTIONAL: Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ===========================================
# OPTIONAL: Security Settings
# ===========================================
ENABLE_IP_BLOCKING=true
ENABLE_USER_AGENT_BLOCKING=true
ENABLE_CONTENT_FILTERING=true
