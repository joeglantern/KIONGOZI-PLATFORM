{
  "expo": {
    "name": "Kiongozi Chat",
    "slug": "kiongozi-mobile-working",
    "version": "2.1.0",
    "description": "Kenya's civic social network — connect with youth, share your voice, and chat with an AI guide on governance, civic rights, and the green economy.",
    "orientation": "portrait",
    "icon": "./assets/party-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "kiongozi",
    "splash": {
      "image": "./assets/kchat-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kiongozi.chat",
      "buildNumber": "16",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:api.kiongozi.org",
        "applinks:kiongozi.org",
        "applinks:www.kiongozi.org"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Kiongozi opens your photo library when you choose a photo or video to attach to a post or message, or to set your profile picture, for example a photo from a community clean-up you are posting about.",
        "NSCameraUsageDescription": "Kiongozi uses your camera when you choose to take a photo for a message or film a clip for Mzinga, for example a picture of a notice from your county office.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "Kiongozi uses your microphone to record sound when you film a clip for Mzinga, for example a short video of a youth meeting with what people said."
      }
    },
    "android": {
      "package": "com.kiongozi.mobile",
      "versionCode": 17,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPrefix": "/posts/"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPrefix": "/@"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPrefix": "/b/"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPrefix": "/t/"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "path": "/week"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPattern": "/api/v1/social/stories/.*/share"
            },
            {
              "scheme": "https",
              "host": "api.kiongozi.org",
              "pathPattern": "/api/v1/baraza/.*/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-party-fg.png",
        "backgroundColor": "#000000"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/kchat-logo.png"
    },
    "plugins": [
      "./plugins/remove-media-playback-permission",
      "./plugins/pod-deployment-target",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#5CB85C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kiongozi opens your photo library when you choose a photo or video to attach to a post or message, or to set your profile picture, for example a photo from a community clean-up you are posting about.",
          "cameraPermission": "Kiongozi uses your camera when you choose to take a photo for a message or film a clip for Mzinga, for example a picture of a notice from your county office.",
          "microphonePermission": "Kiongozi uses your microphone to record sound when you film a clip for Mzinga, for example a short video of a youth meeting with what people said."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "useAndroidX": true,
            "enableJetifier": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Kiongozi uses your microphone to record sound when you film a clip for Mzinga, for example a short video of a youth meeting with what people said."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "owner": "afosi",
    "extra": {
      "eas": {
        "projectId": "740d5736-9f10-4329-b2f5-0ffbb99d5d46"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/740d5736-9f10-4329-b2f5-0ffbb99d5d46"
    }
  }
}
